# Supabase Project Connection (Public Browser & SSR Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional public app origin for confirmation emails. Allow its /auth/callback in Supabase.
# APP_ORIGIN=http://localhost:3000

# Production Camera Policy (set to 'true' only for local webcam-less testing)
NEXT_PUBLIC_ALLOW_CAMERA_FALLBACK=false
